{
  "id": "com.jetbrains.PyCharm-Professional",
  "runtime": "org.freedesktop.Sdk",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "pycharm-wrapper",
  "finish-args": [
    "--device=dri",
    "--filesystem=home",
    "--share=ipc",
    "--share=network",
    "--socket=ssh-auth",
    "--socket=gpg-agent",
    "--socket=fallback-x11",
    "--socket=wayland"
  ],
  "modules": [
    "python3-modules.json",
    {
      "name": "pycharm",
      "buildsystem": "simple",
      "build-commands": [
        "cp -a pycharm-*/* ${FLATPAK_DEST}",
        "cat idea.properties >> ${FLATPAK_DEST}/bin/idea.properties",
        "install -D -t ${FLATPAK_DEST}/bin/ pycharm-wrapper",
        "install -Dm644 -t ${FLATPAK_DEST}/share/metainfo/ ${FLATPAK_ID}.metainfo.xml",
        "install -Dm644 -t ${FLATPAK_DEST}/share/applications/ ${FLATPAK_ID}.desktop",
        "install -Dm644 -t ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/ ${FLATPAK_ID}.svg"
      ],
      "sources": [
        {
          "type": "archive",
          "strip-components": 0,
          "url": "https://download.jetbrains.com/python/pycharm-2026.2.2.tar.gz",
          "sha256": "60448e3fb4e6a700e3d2ad3583ea8de1505b3f436e6715329a5a35e31c34aced",
          "only-arches": [
            "x86_64"
          ],
          "x-checker-data": {
            "type": "jetbrains",
            "code": "PCP",
            "is-main-source": true
          }
        },
        {
          "type": "archive",
          "strip-components": 0,
          "url": "https://download.jetbrains.com/python/pycharm-2026.2.2-aarch64.tar.gz",
          "sha256": "16ff89b445b91c44680031509efcb97a28ba3fd7b094a0dc47dcdd5daa3541e0",
          "only-arches": [
            "aarch64"
          ],
          "x-checker-data": {
            "type": "jetbrains",
            "code": "PCP",
            "is-main-source": true
          }
        },
        {
          "type": "file",
          "path": "com.jetbrains.PyCharm-Professional.metainfo.xml"
        },
        {
          "type": "file",
          "path": "com.jetbrains.PyCharm-Professional.desktop"
        },
        {
          "type": "file",
          "path": "com.jetbrains.PyCharm-Professional.svg"
        },
        {
          "type": "file",
          "path": "idea.properties"
        },
        {
          "type": "script",
          "dest-filename": "pycharm-wrapper",
          "commands": [
            "/app/bin/pycharm $@"
          ]
        }
      ]
    },
    {
      "name": "dbus",
      "buildsystem": "meson",
      "config-opts": [
        "-Dtools=true",
        "-Dmessage_bus=false",
        "-Dsystemd=disabled",
        "-Dx11_autolaunch=disabled"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://dbus.freedesktop.org/releases/dbus/dbus-1.16.4.tar.xz",
          "sha256": "d08b05526c2cb7966a5fb79210d6112b1aca3d135f315c1b302e14b4b0297dac",
          "x-checker-data": {
            "type": "anitya",
            "project-id": 5356,
            "stable-only": true,
            "url-template": "https://dbus.freedesktop.org/releases/dbus/dbus-$version.tar.xz"
          }
        }
      ]
    }
  ]
}
